{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{css,js,json,ico,png,svg}"]
  },
  "routes": [
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/api/*",
      "allowedRoles": ["members"]
    }
  ],
  "platform": {
    "apiRuntime": "node:20"
  }
}
